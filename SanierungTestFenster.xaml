<Window x:Class="DAS_LEBENSARCHIV.SanierungTestFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Testbereich - Neues Datenmodell (Sanierung)"
        Height="640"
        Width="820"
        WindowStartupLocation="CenterOwner">

    <!--
    ============================================================
    SANIERUNG BAUPHASE 1 - TESTBEREICH (08.08.)
    ============================================================
    Bewusst als eigenständiges, isoliertes Fenster ohne jede
    Verbindung zu den echten Daten (personen.json, Sammlungen,
    Ereignisse) - alles hier existiert nur im Arbeitsspeicher dieses
    Fensters, für die Dauer des Tests. Nichts wird gespeichert,
    nichts verändert das bestehende Archiv. Zweck: mit wenigen
    künstlichen Testbildern beweisen, dass das neue Modell
    (Erinnerung/Fundort/Zuordnung) funktioniert, bevor es an anderer
    Stelle im Programm verwendet wird.
    -->

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="16"
            FontWeight="Bold"
            Margin="0,0,0,4"
            Text="Testbereich: Neues Datenmodell (Erinnerung / Fundort / Zuordnung)"/>

        <TextBlock
            Grid.Row="1"
            FontStyle="Italic"
            Foreground="#777777"
            TextWrapping="Wrap"
            Margin="0,0,0,16"
            Text="Rein isolierter Test - berührt keine echten Daten. Alles hier existiert nur, solange dieses Fenster offen ist. Nichts wird gespeichert oder kopiert."/>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Erinnerung + Fundorte -->
            <StackPanel Grid.Column="0">

                <Button
                    Name="NeueErinnerungButton"
                    Content="Neue Test-Erinnerung anlegen (Bild wählen)"
                    Height="36"
                    Margin="0,0,0,10"
                    Click="NeueErinnerung_Click"/>

                <TextBlock
                    Name="ErinnerungInfoText"
                    FontWeight="Bold"
                    TextWrapping="Wrap"
                    Margin="0,0,0,10"
                    Text="Noch keine Test-Erinnerung angelegt."/>

                <TextBlock
                    FontWeight="Bold"
                    Margin="0,10,0,4"
                    Text="Fundorte dieser Erinnerung"/>

                <ListBox
                    Name="FundorteListe"
                    Height="120"
                    Margin="0,0,0,10"/>

                <Button
                    Name="FundortHinzufuegenButton"
                    Content="Weiteren Fundort hinzufügen (Bild wählen)"
                    Height="32"
                    IsEnabled="False"
                    Click="FundortHinzufuegen_Click"/>

            </StackPanel>

            <!-- Zuordnungen -->
            <StackPanel Grid.Column="2">

                <TextBlock
                    FontWeight="Bold"
                    Margin="0,0,0,4"
                    Text="Zuordnungen dieser Erinnerung"/>

                <ListBox
                    Name="ZuordnungenListe"
                    Height="160"
                    Margin="0,0,0,10"
                    SelectionChanged="ZuordnungenListe_SelectionChanged"/>

                <Button
                    Name="ZuordnungEntfernenButton"
                    Content="Markierte Zuordnung entfernen (Papierkorb-Kontext-Regel testen)"
                    Height="36"
                    Margin="0,0,0,16"
                    IsEnabled="False"
                    Click="ZuordnungEntfernen_Click"/>

                <TextBlock Text="Neue Zuordnung anlegen" FontWeight="Bold" Margin="0,0,0,4"/>

                <ComboBox Name="ZielTypComboBox" Margin="0,0,0,8" SelectedIndex="0">
                    <ComboBoxItem Content="Person"/>
                    <ComboBoxItem Content="Ereignis"/>
                    <ComboBoxItem Content="Sammlung"/>
                </ComboBox>

                <TextBox
                    Name="ZielBezeichnungTextBox"
                    Padding="4"
                    Margin="0,0,0,8"/>
                <TextBlock
                    FontStyle="Italic"
                    Foreground="#999999"
                    Margin="0,-6,0,8"
                    Text="z.B. Isabella, Hochzeit oder Familie"/>

                <Button
                    Name="ZuordnungHinzufuegenButton"
                    Content="Zuordnung hinzufügen"
                    Height="32"
                    IsEnabled="False"
                    Click="ZuordnungHinzufuegen_Click"/>

            </StackPanel>

        </Grid>

        <Border
            Grid.Row="3"
            Background="#F0F7EE"
            BorderBrush="#CFE3C8"
            BorderThickness="1"
            Padding="14"
            Margin="0,16,0,0">

            <StackPanel>
                <TextBlock FontWeight="Bold" Margin="0,0,0,6" Text="Beweis-Protokoll"/>
                <TextBlock
                    Name="BeweisText"
                    TextWrapping="Wrap"
                    Text="Noch kein Test durchgeführt."/>
            </StackPanel>

        </Border>

    </Grid>

</Window>
