<Window x:Class="DAS_LEBENSARCHIV.ErinnerungsmodellBetrachterFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="James – Arbeitsmotor (neues Erinnerungsmodell)"
        Height="820"
        Width="920"
        WindowStartupLocation="CenterOwner">

    <!--
    ============================================================
    ARBEITSMOTOR (09.08.) + INTEGRATIONSAUFTRAG (10.08.)
    ============================================================
    Oben: Suche (Dateiname/Ordner/Zuordnung/Sehzentrum-Merkmal
    gemeinsam) + Sortierung + Testimport + Sehzentrum-Diagnose.
    Darunter: auswählbare Trefferliste -> AM-Arbeitsauswahl.
    Danach: Weg C (von einem Ziel aus zugeordnete E holen ODER
    gezielt aus diesem Ziel entfernen -> Zuordnungs-Papierkorb).
    Ganz unten: der Zuordnungs-Papierkorb selbst (wiederherstellen/
    endgültig löschen) - betrifft nie die Erinnerung oder Fundorte.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="360"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="16"
            FontWeight="Bold"
            Margin="0,0,0,4"
            Text="James – Arbeitsmotor"/>

        <TextBlock
            Grid.Row="1"
            FontStyle="Italic"
            Foreground="#777777"
            TextWrapping="Wrap"
            Margin="0,0,0,10"
            Text="Suchen, sortieren, markieren und zuordnen - auf dem neuen Erinnerungsmodell. Rein lesend gegenüber personen.json; Testimport kopiert zusätzliche Dateien additiv."/>

        <!-- Such-/Sortier-/Testimport-/Diagnose-Leiste -->
        <Border
            Grid.Row="2"
            Background="#F5F5F5"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            Padding="12"
            Margin="0,0,0,10">

            <StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Suchen:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Name="SucheTextBox" Width="320" Padding="4" TextChanged="SucheOderSortierung_Changed"/>
                    <TextBlock Text="Sortieren:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox Name="SortierungComboBox" Width="140" SelectionChanged="SucheOderSortierung_Changed">
                        <ComboBoxItem Content="Datum (neueste zuerst)"/>
                        <ComboBoxItem Content="Alphabetisch"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock
                    FontStyle="Italic"
                    Foreground="#999999"
                    Margin="0,0,0,8"
                    Text="Durchsucht Dateiname, Ordner, zugeordnete Person/Ereignis/Sammlung und von James im Sehzentrum gelernte Bildmerkmale gemeinsam (z.B. „Hund“, „Isabella“, „Hochzeit“)."/>

                <StackPanel Orientation="Horizontal">
                    <Button
                        Name="TestimportDateiButton"
                        Content="📄 Einzelne Datei(en) importieren..."
                        Padding="10,4"
                        Margin="0,0,10,0"
                        Click="TestimportDatei_Click"/>

                    <Button
                        Name="TestimportOrdnerButton"
                        Content="📁 Ganzen Ordner importieren..."
                        Padding="10,4"
                        Margin="0,0,10,0"
                        Click="TestimportOrdner_Click"/>

                    <Button
                        Name="SehzentrumPruefenButton"
                        Content="🔎 Sehzentrum-Datenbestand prüfen"
                        Padding="10,4"
                        Click="SehzentrumPruefen_Click"/>
                </StackPanel>

            </StackPanel>

        </Border>

        <!-- Trefferliste (Gesamtübersicht/Suchergebnisse) - auswählbar -->
        <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="1" Padding="8">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Name="ErgebnisText" FontWeight="Bold" Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ListBox Name="ErgebnisListe" SelectionMode="Extended" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ErgebnisListe_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </ScrollViewer>

                <Button
                    Grid.Row="2"
                    Name="AusgewaehlteZurAmButton"
                    Content="Ausgewählte zur Arbeitsmappe schicken"
                    Padding="10,4"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    IsEnabled="False"
                    Click="AusgewaehlteZurAm_Click"/>

            </Grid>

        </Border>

        <!-- Weg C -->
        <Border
            Grid.Row="4"
            Background="#F0F7EE"
            BorderBrush="#CFE3C8"
            BorderThickness="1"
            Padding="14"
            Margin="0,10,0,10">

            <StackPanel>
                <TextBlock FontWeight="Bold" Margin="0,0,0,8" Text="Weg C: Erinnerungen eines Ziels zur Arbeitsmappe schicken - oder daraus entfernen"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox Name="ZielTypComboBox" Width="110" Margin="0,0,8,0" SelectionChanged="ZielAuswahl_Changed">
                        <ComboBoxItem Content="Person"/>
                        <ComboBoxItem Content="Ereignis"/>
                        <ComboBoxItem Content="Sammlung"/>
                    </ComboBox>
                    <ComboBox Name="ZielObjektComboBox" Width="220" SelectionChanged="ZielAuswahl_Changed"/>
                </StackPanel>

                <TextBlock FontStyle="Italic" Foreground="#999999" Margin="0,0,0,6" Text="Zeigt nur Erinnerungen, die diesem Ziel bereits im neuen Modell zugeordnet sind."/>

                <ListBox Name="ZielErinnerungenListe" Height="120" Margin="0,0,0,8" SelectionMode="Extended" SelectionChanged="ZielErinnerungenListe_SelectionChanged"/>

                <StackPanel Orientation="Horizontal">
                    <Button Name="ZurAmSchickenButton" Content="Ausgewählte zur Arbeitsmappe schicken" Padding="10,4" Margin="0,0,10,0" IsEnabled="False" Click="ZurAmSchicken_Click"/>
                    <Button Name="AusZielEntfernenButton" Content="Ausgewählte aus diesem Ziel entfernen (Papierkorb)" Padding="10,4" IsEnabled="False" Click="AusZielEntfernen_Click"/>
                </StackPanel>
            </StackPanel>

        </Border>

        <!-- Zuordnungs-Papierkorb -->
        <Border
            Grid.Row="5"
            Background="#FBF3F0"
            BorderBrush="#E3C8C8"
            BorderThickness="1"
            Padding="14">

            <StackPanel>
                <TextBlock FontWeight="Bold" Margin="0,0,0,8" Text="Zuordnungs-Papierkorb"/>
                <TextBlock Name="PapierkorbText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock FontStyle="Italic" Foreground="#999999" Margin="0,0,0,6" Text="Betrifft ausschließlich die Zuordnung - die Erinnerung selbst und ihre physischen Fundorte bleiben immer unverändert."/>

                <ListBox Name="PapierkorbListe" Height="120" Margin="0,0,0,8" SelectionMode="Extended" SelectionChanged="PapierkorbListe_SelectionChanged"/>

                <StackPanel Orientation="Horizontal">
                    <Button Name="PapierkorbWiederherstellenButton" Content="Wiederherstellen" Padding="10,4" Margin="0,0,10,0" IsEnabled="False" Click="PapierkorbWiederherstellen_Click"/>
                    <Button Name="PapierkorbEndgueltigLoeschenButton" Content="Endgültig löschen" Padding="10,4" IsEnabled="False" Click="PapierkorbEndgueltigLoeschen_Click"/>
                </StackPanel>
            </StackPanel>

        </Border>

    </Grid>
    </ScrollViewer>

</Window>
