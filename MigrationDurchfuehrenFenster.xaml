<Window x:Class="DAS_LEBENSARCHIV.MigrationDurchfuehrenFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sicherung + Migration durchführen (Bauphase 3)"
        Height="680"
        Width="780"
        WindowStartupLocation="CenterOwner">

    <!--
    ============================================================
    SANIERUNG BAUPHASE 3 - SICHERUNG + ECHTER MIGRATIONSLAUF (08.08.)
    ============================================================
    A's Sicherheitsauflage: Schritt 2 (Migration) ist erst möglich,
    nachdem Schritt 1 (Sicherungskopie) erfolgreich erstellt UND
    verifiziert wurde. personen.json und alle bestehenden Strukturen
    bleiben dabei unverändert - es wird ausschließlich eine NEUE
    Datei (erinnerungsmodell.json) erzeugt. Keine physische
    Foto-Datei wird kopiert oder verschoben.
    -->

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="16"
            FontWeight="Bold"
            Margin="0,0,0,4"
            Text="Sicherung + Migration durchführen"/>

        <TextBlock
            Grid.Row="1"
            FontStyle="Italic"
            Foreground="#777777"
            TextWrapping="Wrap"
            Margin="0,0,0,14"
            Text="Schritt 1 sichert personen.json unverändert. Schritt 2 erzeugt daraus das neue Erinnerungs-/Zuordnungsmodell in einer NEUEN, eigenen Datei. personen.json bleibt dabei unverändert - keine physische Foto-Datei wird kopiert oder verschoben."/>

        <Border
            Grid.Row="2"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            Padding="14"
            Margin="0,0,0,14">
            <StackPanel>
                <TextBlock FontWeight="Bold" Margin="0,0,0,8" Text="Schritt 1: Sicherungskopie von personen.json"/>
                <TextBlock
                    Name="SicherungPfadText"
                    TextWrapping="Wrap"
                    Margin="0,0,0,8"
                    Text="Sicherungsziel wird beim Klick festgelegt und hier angezeigt."/>
                <Button
                    Name="SicherungErstellenButton"
                    Content="Sicherung jetzt erstellen"
                    Width="220"
                    Height="36"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    Click="SicherungErstellen_Click"/>
                <TextBlock
                    Name="SicherungStatusText"
                    TextWrapping="Wrap"
                    FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="3"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            Padding="14"
            Margin="0,0,0,14">
            <StackPanel>
                <TextBlock FontWeight="Bold" Margin="0,0,0,8" Text="Schritt 2: Migration (erst nach verifizierter Sicherung möglich)"/>
                <Button
                    Name="MigrationStartenButton"
                    Content="Migration jetzt starten"
                    Width="220"
                    Height="36"
                    HorizontalAlignment="Left"
                    IsEnabled="False"
                    Click="MigrationStarten_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <ProgressBar
                Name="Fortschrittsleiste"
                Height="20"
                Minimum="0"
                Maximum="100"
                Margin="0,0,0,6"/>
            <TextBlock
                Name="StatusText"
                TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <TextBox
                Name="ErgebnisText"
                IsReadOnly="True"
                TextWrapping="Wrap"
                BorderThickness="0"
                Background="Transparent"
                FontFamily="Consolas"/>
        </ScrollViewer>

    </Grid>

</Window>
