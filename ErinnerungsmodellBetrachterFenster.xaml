<Window x:Class="DAS_LEBENSARCHIV.ErinnerungsmodellBetrachterFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neues Erinnerungsmodell - Betrachter"
        Height="700"
        Width="850"
        WindowStartupLocation="CenterOwner">

    <!--
    ============================================================
    SANIERUNG - BETRACHTER + WEG C (09.08.)
    ============================================================
    Oben: rein lesende Gesamtübersicht über erinnerungsmodell.json -
    dient als Kontroll-/Testwerkzeug (Testziel 6 von A's Auftrag).
    Unten: Weg C - von einem Ziel (Person/Ereignis/Sammlung) aus die
    dort bereits im NEUEN Modell zugeordneten Erinnerungen markieren
    und zur Arbeitsmappen-Arbeitsauswahl schicken. Zeigt nur, was im
    neuen Modell bereits zugeordnet ist - nicht den kompletten alten
    Archiv-Bestand.
    -->

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="16"
            FontWeight="Bold"
            Margin="0,0,0,4"
            Text="Neues Erinnerungsmodell - Betrachter"/>

        <TextBlock
            Grid.Row="1"
            FontStyle="Italic"
            Foreground="#777777"
            TextWrapping="Wrap"
            Margin="0,0,0,14"
            Text="Rein lesend - zeigt den Inhalt von erinnerungsmodell.json. Ganz unten: Erinnerungen eines Ziels direkt zur Arbeitsmappe schicken (Weg C)."/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Name="GesamtUebersichtText" FontWeight="Bold" Margin="0,0,0,8"/>
                <ItemsControl Name="GesamtUebersichtListe"/>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="3"
            Background="#F0F7EE"
            BorderBrush="#CFE3C8"
            BorderThickness="1"
            Padding="14"
            Margin="0,14,0,0">

            <StackPanel>
                <TextBlock FontWeight="Bold" Margin="0,0,0,8" Text="Weg C: Erinnerungen eines Ziels zur Arbeitsmappe schicken"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox Name="ZielTypComboBox" Width="110" Margin="0,0,8,0" SelectionChanged="ZielAuswahl_Changed">
                        <ComboBoxItem Content="Person"/>
                        <ComboBoxItem Content="Ereignis"/>
                        <ComboBoxItem Content="Sammlung"/>
                    </ComboBox>
                    <ComboBox Name="ZielObjektComboBox" Width="220" SelectionChanged="ZielAuswahl_Changed"/>
                </StackPanel>

                <TextBlock FontStyle="Italic" Foreground="#999999" Margin="0,0,0,6" Text="Zeigt nur Erinnerungen, die diesem Ziel bereits im neuen Modell zugeordnet sind."/>

                <ListBox Name="ZielErinnerungenListe" Height="120" Margin="0,0,0,8" SelectionMode="Extended" SelectionChanged="ZielErinnerungenListe_SelectionChanged"/>

                <Button Name="ZurAmSchickenButton" Content="Ausgewählte zur Arbeitsmappe schicken" Padding="10,4" HorizontalAlignment="Left" IsEnabled="False" Click="ZurAmSchicken_Click"/>
            </StackPanel>

        </Border>

    </Grid>

</Window>
